EXP-3A: Waveform Generation using DAC 0808
#include <reg51.h>
void msdelay(void);

//1. Ramp Wave Generation ---
void ramp_wave(void) {
    unsigned int x = 0;
    P1 = 0x00;
    while(1) {
        P1 = x;
        x++;
    }
}

//2. Square Wave Generation ---
void square_wave(void) {
    unsigned int x = 0;
    while(1) {
        P1 = 0x00;
        msdelay();
        P1 = 0xFF;
        msdelay();
    }
}

//3. Triangular Wave Generation ---
void triangular_wave(void) {
    while(1) {
        P1 = 0x00;
        // Increment up to 255
        for(unsigned int x = 0; x < 256; x++) {
            P1 = x;
        }
        // Decrement back down from 255
        for(unsigned int x = 255; x > 0; x--) {
            P1 = x;
        }
    }
}
void msdelay(void) {
    unsigned int i, j;
    for(i = 0; i < 500; i++) {
        for(j = 0; j < 1275; j++);
    }
}




