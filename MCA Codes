//EXP-1: 8051 Port Interfacing & LEDs Blinking
#include <reg51.h>
void msdelay(unsigned int time) {
    unsigned int i, j;
    for (i = 0; i < time; i++)
        for (j = 0; j < 1275; j++);
}

void main() {
    P1 = 0x00;          // Initialize Port 1
    while(1) {
        P1 = 0x00;      // LEDs OFF
        msdelay(100);
        P1 = 0xFF;      // LEDs ON
        msdelay(100);
    }
}




