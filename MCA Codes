EXP-6: Interfacing a 16x2 LCD with LPC2148 and Displaying a Message
#define IO0SET    (*(volatile unsigned long *)0xE0028004)
#define IO0SET    (*(volatile unsigned long *)0xE0028004)
#define IO0DIR    (*(volatile unsigned long *)0xE0028008)
#define IO0CLR    (*(volatile unsigned long *)0xE002800C)
#define PINSEL0   (*(volatile unsigned long *)0xE002C000)
#define PINSEL1   (*(volatile unsigned long *)0xE002C004)
#define RS        (1<<5)//P0.5
#define RW        (1<<6)//P0.6
#define EN        (1<<7)//P0.7
#define LCD_DATA  0x0000FF00

void delay(void)
{
    unsigned long i;
    for(i=0; i<50000; i++);
}

void lcd_cmd(unsigned char cmd)
{
    IO0CLR = RS;
    IO0CLR = RW;
    IO0CLR = LCD_DATA;
    IO0SET = ((unsigned long)cmd<<8);
    IO0SET = EN;
    delay();
    IO0CLR = EN;
    delay();
}

void lcd_data(unsigned char data)
{
    IO0SET = RS;
    IO0CLR = RW;
    IO0CLR = LCD_DATA;
    IO0SET = ((unsigned long)data<<8);
    IO0SET = EN;
    delay();
    IO0CLR = EN;
    delay();
}

void lcd_init(void)
{
    delay();
    lcd_cmd(0x38);
    lcd_cmd(0x0C);
    lcd_cmd(0x01);
    lcd_cmd(0x06);
    lcd_cmd(0x80);
}

int main(void)
{
    PINSEL0 = 0x00000000;
    PINSEL1 = 0x00000000;

        Configure:
        P0.5 -> RS
        P0.6 -> RW
        P0.7 -> EN
        P0.8-P0.15 -> LCD D0-D7
        Mask = 0x0000FFEO
    
    IO0DIR = 0x0000FFE0;
    IO0CLR = 0x0000FFE0;
    
    lcd_init();
    lcd_data('N');
    lcd_data('M');
    lcd_data('I');
    lcd_data('E');
    lcd_data('T');
    
    while(1)
    {
        /* Keep displaying NMIET */
    }
}




EXP-7: UART0 Echo Communication Using LPC2148
#define PINSEL0   (*(volatile unsigned int *)0xE002C000)
#define IO0DIR    (*(volatile unsigned int *)0xE0028008)
#define U0RBR     (*(volatile unsigned int *)0xE000C000) // Receiver Buffer Register
#define U0THR     (*(volatile unsigned int *)0xE000C000) // Transmit Holding Register
#define U0DLL     (*(volatile unsigned int *)0xE000C000) // Divisor Latch LSB
#define U0DLM     (*(volatile unsigned int *)0xE000C004) // Divisor Latch MSB
#define U0LCR     (*(volatile unsigned int *)0xE000C00C) // Line Control Register
#define U0LSR     (*(volatile unsigned int *)0xE000C014) // Line Status Register

int main(void)
{
    char value;
    
    PINSEL0 = 0x00000005;  // P0.0 - TXD0; P0.1 - RXD0
    IO0DIR  = 0x00000001;  // Set P0.0 as output
    U0LCR = 0x83;          // Unlock Divisor Latches (DLAB = 1)
    U0DLM = 0x00;          // Set baud rate to 9600
    U0DLL = 0x97;          
    U0LCR = 0x03;          // Lock Baud Rate (DLAB = 0)
    
    while(1)
    {
        while (!(U0LSR & 0x01)); // Check received data ready bit
        value = U0RBR;           // Read valid data
        
        while (!(U0LSR & 0x20)); // Monitor if transmit register is empty
        U0THR = value;           // Transfer contents to U0THR
    }
}
